# 云效配置（复制为 .env.local 后填写）
# .env.local 已被 .gitignore 排除，切勿提交

# 云效组织 id：https://devops.aliyun.com/organization/<id>
YUNXIAO_ORGANIZATION_ID=

# 云效个人访问令牌：https://devops.aliyun.com/settings/personal-access-tokens
YUNXIAO_TOKEN=

# 云效 OpenAPI 地址（一般无需修改）
YUNXIAO_OPEN_API=https://openapi-rdc.aliyuncs.com
